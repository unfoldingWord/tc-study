; Format 3: types shared by every class. The byte encodings of the column types are in container.md.

; ---- The file header (container.md) ----

segment-header = {
  "h": logical-header,
  "codec": "deflate-raw",
  "clen": uint,
  "ulen": uint,
  "id": sha256,
  ? "sig": [+ signature],      ; catalog only (catalog.md)
  * tstr => any,               ; keys a later minor version adds; readers ignore them
}

signature = { "key": tstr, "alg": "ed25519", "s": bstr .size 64 }

logical-header = {
  "class": class-name,
  "v": uint,
  "tables": { * table-name => [version: uint, required: bool] },
  ? "lang": tstr,
  ? "book": book-code,
  ? "part": "core" / book-code,
  ? "group": tstr,
  ? "orig": [original-key: tstr, original-stamp: tstr],
  ? "res": [* [resource-key: tstr, release-stamp: tstr]],
}

class-name = "catalog" / "xmap" / "map" / "book" / "orig" / "art" / "lex" / "obs" / "gen"
table-name = tstr              ; lowercase ASCII letters, digits and "-", starting with a letter

; The body: the logical header again, and the tables.
body<H, T> = { "h": H, "t": T }

; ---- Columns (container.md, "Column encodings") ----

uvarints = bstr                ; unsigned LEB128 numbers, one after the other
svarints = bstr                ; zigzag, then as uvarints
deltas = bstr                  ; svarints of each value minus the previous one (the first minus 0)
bits = bstr                    ; one bit per row, least significant bit first
strtab = [* tstr]              ; numbered from 0
texts = { "utf8": bstr, "len": uvarints }
sha256 = bstr .size 32

; A column of a table with n rows. "has" is present when some rows lack the value; the values then list only the
; rows whose bit is 1.
column = {
  ? "has": bits,
  (
    "strings": uvarints        ; numbers in the segment's string table
    // "texts": texts           ; long text: notes, questions, answers
    // "flags": bits            ; true or false
    // "uints": uvarints        ; small numbers
  ),
}

; ---- Ids (ids.md) ----

book-code = tstr .regexp "[0-9a-z]{3}"
verse-id = uint                ; LLCCCVVV
concept-id = tstr              ; "tw:kt/grace", "ta:translate/figs-metaphor", "per:abraham", "obs:10" ...
res-index = uint               ; a resource, by its index in the header's "res"

; Verse ranges of n rows: the first verse id of each row as deltas, and the last verse id minus the first.
; Both ends are included. A range across chapters (1:12-2:3) is still two verse ids; span is their difference.
ranges = { "from": deltas, "span": uvarints }

; One bit per book of the canonical order (ids.md): bit 0 is gen, bit 65 is rev. 9 bytes. Bits are numbered from the least
; significant bit of the first byte (bit 8 is the least significant bit of the second byte).
book-set = bstr .size 9

; What a source covers (counts.md): per source key, the books it covers whole, and the books it covers only in part. A book
; in both sets is E_BODY.
coverage = { * tstr => [whole: book-set, ? partial: book-set] }

; ---- Counts of the maps (counts.md) ----

; Per key and book: how many, and in how many distinct verses. "keys" are sorted by code point. "counts" holds, per
; key in that order: the number of books b; then per book, in canonical order: its book number minus the previous
; one written for this key (the first minus 0), the count, and the number of distinct verses.
counts = { "unit": count-unit, "keys": strtab, "counts": uvarints }
count-unit = "occurrences" / "links" / "notes"

; Rules of counts: a key lists at least one book; the book numbers of a key strictly increase (so the first delta is
; at least 1, and so are the others); 1 <= count; 0 <= verses (verses may exceed count: a note on 1:2-4 is 1 note and 3 verses; it is 0 for
; rows whose reference cannot be read, counts.md: the builder counts such a row at verse 0, so its verse may be counted
; once more than the readable rows say). The "unit" of each table is fixed:
; xmap "strong" is "occurrences", "links" is "links", "notes" is "notes"; map "usage" is "notes".

; The verses behind the counts, for one book. "keys" are the keys this book has with at least one verse (a key whose
; rows in this book cover no verse is left out of the part), sorted by code point. "verses" holds,
; per key in that order: the number of distinct verses n (n >= 1), then n values, each the verse id mod 1 000 000
; minus the previous value of the same key (the first minus 0). The first value may be 0 (front:intro, verse 0); the
; ids rebuilt by adding the values up are strictly increasing and below 1 000 000. The book is the header's "book".
; Why the keys are written here and not as numbers of the core's key table: a part numbered against the core's table
; would change in all 66 books whenever one key is added anywhere.
verse-lists = { "keys": strtab, "verses": uvarints }
