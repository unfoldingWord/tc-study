; Format 3: the catalog (catalog.md). A segment of class "catalog"; its header may carry signatures ("sig").

catalog-segment = body<catalog-header, catalog-tables>

catalog-header = {
  "class": "catalog",
  "v": 1,
  "tables": { * table-name => [uint, bool] },
  ? "lang": tstr,              ; absent in the common catalog
}

catalog-tables = {
  "about": about,              ; required, v1
  "resources": [* resource],   ; required, v1
  "segments": [* segment-entry],   ; required, v1; ordered by class, then book, part or group
  "units": [* unit],           ; required, v1; ordered by id
  ? "requires": [* [catalog: tstr, revision: uint, id: sha256]],   ; optional, v1; e.g. the common catalog
  ? "complements": [* complement],   ; optional, v1
}

about = {
  "format": "3.0",
  "catalog": tstr,             ; the catalog's name: the language tag, or "common"
  "publisher": tstr,           ; "unfoldingWord", or "local:" and a device name for a catalog built on a device
  "origin": "published" / "local",
  "revision": uint,            ; grows with every publication of this catalog by this publisher
  ? "previous": sha256,        ; the id of the revision before
  "built": tstr,               ; RFC 3339 date and time of the build
  "builder": tstr,             ; the builder's name and version
  ? "name": tstr,              ; the language's name, in the language
  ? "direction": "ltr" / "rtl",
}

resource = {
  "key": tstr,                 ; "es-419_gl/es-419/tn"
  "title": tstr,
  "subject": tstr,             ; Door43's subject ("TSV Translation Notes", "Aligned Bible", ...)
  "release": tstr,             ; the release it was built from
  "license": tstr,             ; SPDX id when there is one ("CC-BY-SA-4.0")
  ? "rights": tstr,            ; the holder, as the resource states it
  ? "attribution": tstr,       ; the credit line an app shows
  ? "source": tstr,            ; the aggregator the data came from ("aquifer"): a patch catalog's resource
  ? "review": "none" / "community" / "professional" / "mixed",   ; the review level of the source's articles; "mixed" when they differ
  ? "audience": "translators" / "readers",   ; who the text is for: a tool for translators, or a version for readers (a Bible text of a patch catalog)
  ? "style": "literal" / "simple" / "dynamic",   ; how it renders its source: close to the form, clear and simplified, or meaning first
  "books": book-set,           ; the books it has (all zeros for resources without books)
}

segment-entry = {
  "id": sha256,
  "class": class-name,
  ? "book": book-code,
  ? "part": "core" / book-code,
  ? "group": tstr,
  "size": uint,                ; the file's size, compressed: what a download weighs
  "ulen": uint,
  "inputs": sha256,            ; fingerprint of what it was built from (catalog.md, "What changes")
}

unit = {
  "id": tstr,                  ; "book:tit", "orig:tit", "map", "xmap", "topics", "xtopics", "art:tw:kt", "lex:G5", "obs", "aligned:a-and ha", "aligned:ar-b", "aligned:other"
  "segments": [+ uint],        ; indexes in "segments"
  ? "needs": [* tstr],         ; unit ids, in this catalog or in one it requires
  ? "optional": true,          ; a device installs the unit only when asked. Every "aligned:{part}" unit carries it, with the
                               ; value true; no other unit does. Only true is valid (false or a non-bool is E_BODY)
}

complement = {
  "kind": tstr,                ; "classifier", "vectors", "numbers", "language-id", "model", "images", "basemap"
  ? "lang": tstr,
  "id": sha256,
  "size": uint,
  "media": tstr,               ; media type of the bytes
  "version": tstr,
  ? "for": tstr,               ; what it works with, e.g. the version of the library's queries
  ? "license": tstr,
}

; The bytes of a complement whose kind is "basemap" and whose version is "1" (catalog.md, "The basemap complement"): a CBOR map, deflate-raw
; compressed (the codec of the segments, with no container), at most 4 MiB inflated. The sha256 of the compressed bytes is the complement's "id".
; A reader rejects it (E_INFLATE for a stream that is not complete deflate or inflates to more, E_BODY for the rest) when:
; - a key listed here is missing or of another type; bbox is not four integers, has west after east or south after north, or leaves the
;   globe (west and east -18000 to 18000, south and north -9000 to 9000); a key not listed here is ignored;
; - layer and count have different lengths; a layer is not 1 to 3; a count is below 3 on a closed path (layer 1 or 2) or below 2 on an open one (3);
; - x or y has other than the sum of count values; a point is outside bbox (the edges are inside).
; A closed path does not repeat its first point at the end. The paths are in the order the builder writes them (land, lakes, rivers).
basemap-v1 = {
  "bbox": [west: int, south: int, east: int, north: int],   ; degrees x 100 (800, 2200, 5200, 4300 for the first map)
  "layer": uvarints,           ; per path: 1 land (closed), 2 lake (closed), 3 river (open)
  "count": uvarints,           ; per path: how many points
  "x": deltas,                 ; the points of all the paths, path after path: longitude x 100; the deltas run across paths
  "y": deltas,                 ; latitude x 100
}
