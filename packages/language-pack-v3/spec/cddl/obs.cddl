; Format 3: the Open Bible Stories segment. One language: the 50 stories with their frames, and the helps that point to
; frames instead of verses.

obs-segment = body<obs-header, obs-tables>

obs-header = {
  "class": "obs",
  "v": 1,
  "tables": { * table-name => [uint, bool] },
  "lang": tstr,
  "res": [+ [tstr, tstr]],
}

obs-tables = {
  "strings": strtab,           ; required, v1; as in the book segment: the short values of the helps
  "stories": [* story],        ; required, v1; ordered by number
  ? "notes": obs-helps,        ; optional, v1 (OBS tN)
  ? "questions": obs-helps,    ; optional, v1 (OBS tQ)
  ? "links": obs-helps,        ; optional, v1 (OBS tWL)
  ? "study-notes": obs-helps,  ; optional, v1 (OBS SN)
  ? "study-questions": obs-helps,   ; optional, v1 (OBS SQ)
}

story = {
  "res": res-index,
  "n": uint,                   ; 1 to 50
  "title": tstr,
  ? "reference": tstr,         ; the closing line as published ("Una historia bíblica tomada de: Génesis 1-2")
  ? "refs": [* [verse-id, verse-id]],   ; the same, as verse ranges, when the builder could read it
  "frames": [+ frame],
}

frame = {
  "n": uint,                   ; 0 to 99, so that story × 100 + frame names one frame
  "text": tstr,                ; minimal markdown
  ? "image": tstr,             ; the image's URL as published; images do not travel in the segment
}

; As the book segment's helps (book.cddl), with frames in place of verse ranges: story × 100 + frame, and frame 0 for
; the story's title or introduction. The canonical reference text of a row is "N:F" ("10:3"), and "N:intro" for frame 0;
; any other text of a row ("10:03", "10:0", "10:front", or one that names no frame, which is placed at frame 0) is kept in
; "refText".
obs-helps = {
  "res": res-index,
  "n": uint,
  "id": { "ascii4": bstr } / { "strings": uvarints },
  "frame": uvarints,
  ? "refText": [* [row: uint, tstr]],
  ? "concept": column,
  "cols": { * tstr => column },
}
