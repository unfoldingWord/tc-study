; Format 3: the common topics. The same for every language: the people, places, events, stories and sections of the
; Bible, each with the verses that mention it, from TIPNR, Theographic, English OBS and the English tN outlines. A core
; with the topics and their counts, and one part per book with the verses behind the counts. The map never depends on
; this class and this class never depends on the map (ids.md).

xtopics-segment = body<xtopics-header, xtopics-tables>
xtopics-tables = xtopics-core-tables / xtopics-part-tables

xtopics-header = {
  "class": "xtopics",
  "v": 1,
  "tables": { * table-name => [uint, bool] },
  "part": "core" / book-code,
  ? "book": book-code,         ; equal to "part" in a book's part
  "res": [* [tstr, tstr]],     ; every source in the core with its release; tables name them by index. Empty in a part
                               ; (the release of each source is in the core and in the catalog)
}

xtopics-core-tables = {
  "coverage": coverage,        ; required, v1; per source key: the books it covers
  "topics": topics,            ; required, v1
  ? "relations": topic-relations,   ; optional, v1
  ? "strongs": { * topic-id => [+ tstr] },   ; optional, v1; per person or place, the Strong keys of its name
                               ; (TIPNR dStrongs, written as Strong keys by the rules of ids.md "Strong keys"), sorted by code
                               ; point, no repeat
  "occurrences": counts,       ; required, v1; unit "verses": per topic, the books and how many verses mention it;
                               ; here count == verses (distinct verses) and 1 <= count
  ? "ranges": { * topic-id => [+ [verse-id, verse-id]] },  ; optional, v1; for stories and sections: the verse
                               ; ranges they span: first and last verse of each range, first <= last. A reader checks
                               ; that both are verse ids of a book 1..66 and that first <= last; it does not check that
                               ; both ends are in one book, or that the verses exist in any original
  ? "chunks": { * book-code => [+ [verse-id, verse-id]] },  ; optional, v1; the sections of the English ULT (its \ts\* chunks), per book, in order: first and last verse of each, first <= last, no overlap, ascending.
                               ; Every verse id is of the book of the key. A book whose ULT has no \ts\* has no key
  ? "obs-frames": { * tstr => [+ [verse-id, verse-id]] },  ; optional, v1; core only; the verses each Open Bible Stories frame
                               ; tells, from bible-story-builder (fuentes.md). Key: the frame "N:F", story 1 to 50 and frame 1 to
                               ; 99, decimal, no leading zeros ("1:3"); the map in the deterministic order of container.md, like every
                               ; map ("1:2" before "1:10": the shorter encoding first). Value: its
                               ; verse ranges in the order of the source, first <= last, both in one chapter (the builder splits a
                               ; range of the source that crosses chapters). A frame that tells no verse has no key. A reader
                               ; checks the key form, each pair as in "ranges", and that both ends are in one chapter
  ? "gender": uvarints,        ; optional, v1; core only; the gender of each person, from ACAI (ids.md, "People of ACAI"): one
                               ; number per row of topics.ids, in its order: 0 no data, 1 man, 2 woman. Only a topic of kind
                               ; person whose id starts "per:" may have 1 or 2. A reader checks the length, the values and that
                               ; rule. A column, not a map by id: the ids are already in topics.ids, so nothing is repeated.
                               ; Another value would be a new version of the table (v2), which a reader of v1 skips; a core
                               ; where every value is 0 has no table
  ? "geo": geo,                ; optional, v1; core only; the point, certainty and form of each place (ids.md, "Builder rules: geo")
  ? "routes": routes,          ; optional, v1; core only; the builder's list of routes (ids.md, "Builder rules: routes")
}

; Columns aligned with every row of topics.ids, as "gender" is: row i is topic i. A row that is not a place has 0 in the four
; columns (they compress to almost nothing). A reader checks, and rejects the segment with E_BODY otherwise:
; - the four columns have as many values as topics.ids;
; - a topic whose kind is not place (2) has sure = form = lat = lon = 0; a place has form 1 to 5;
; - sure is 0 to 3; with sure = 0, lat = lon = 0; with sure above 0, lat is -9000 to 9000 and lon -18000 to 18000
;   ((0, 0) is a valid point: "no point" is sure = 0, not a position);
; - the table is in a core only. The scale (x 100) is fixed. Another value of sure or form would be a new version of the
;   table (v2), which a reader of v1 skips after decoding it (container.md).
geo = {
  "lat": deltas,               ; per topic: latitude x 100 rounded (0.01 degrees, about 1 km); 0 when sure is 0
  "lon": deltas,               ; longitude x 100 rounded; 0 when sure is 0
  "sure": uvarints,            ; 0 no point; 1 low; 2 medium; 3 high (how it is decided: ids.md)
  "form": uvarints,            ; 0 not a place; 1 point (town, city, camp, gate, well); 2 area (region, nation, province,
                               ; desert); 3 water (river, sea, lake, spring); 4 height (mount, hill, range); 5 port (a point
                               ; that is also a seaport: drawn and measured as 1, and sailed to in travel days)
}

; Where this design says "form 1", form 5 counts too. A reader checks, and rejects with E_BODY otherwise:
; - event and count have the same number of values; stops has the sum of count;
; - every event is a row of topics.ids whose kind is event (3), and no event is repeated (one route per event); the order of
;   the table is the order the builder's list has, which is the order shown, and is not sorted;
; - every count is 2 or more; every stop is a row whose kind is place (2); a stop is never the same row as the stop before it
;   in its route (a place may come back later: Jerusalem);
; - a stop may have no point (geo sure 0) or no geo at all: that is valid.
; The verse of a stop is not stored (ids.md, "Builder rules: routes"). The table may have no route; a builder does not write it then.
routes = {
  "event": uvarints,           ; per route: a row of topics.ids
  "count": uvarints,           ; per route: how many stops
  "stops": uvarints,           ; the stops of all routes, route after route, in travel order: rows of topics.ids
}

topic-id = concept-id          ; "per:", "lug:", "ev:", "tema:" (kind 4), "sec:", "obs:" ids (ids.md)

topics = {
  "ids": strtab,               ; every topic id, sorted by code point
  "kind": uvarints,            ; per id: person 1, place 2, event 3, topic 4, story 5, section 6
  "source": uvarints,          ; per id: the index in "res" of the source that defines it
  "ref": uvarints,             ; per id: an index in "refs", the source's own key (TIPNR unique name; Theographic
                               ; eventID as text; OBS story number; outline range)
  "refs": strtab,              ; the distinct ref texts, in the order of their first use by "ids"; no text twice. Two
                               ; topics may share a ref (the same outline range under two ids)
  "title": strtab,             ; per id (as many as ids, "" for none): the English title shown when a language has no
                               ; name: TIPNR's unified name before "@" (people, places), the Theographic title or the
                               ; builder's list title (events), the outline heading (sections). "" for an OBS story: only its
                               ; reference is taken from OBS, never its title (fuentes.md).
                               ; "" when the source gives none: a reader then has no title to show and the answer
                               ; leaves "title" out; the app shows the id
  "ustrong": strtab,           ; per id (as many as ids, "" for none): TIPNR's uStrong of a person or place, kept so
                               ; that the id can be derived again (ids.md)
}

; Like xmap "relations", and "from" and "to" number the rows of topics.ids. An end that is not a topic of this
; segment but a concept of the common map (tw:names/abraham) is named by id in "external", and its number is the
; count of topics.ids plus the index in "external". Both ends may be external (a relation between two concepts of
; the map that only this module asserts). Concepts are never merged: "same-as" is a relation like any other.
; The types and their direction are in ids.md ("Relation types of xtopics"): participant and place go from the event,
; tribe from the person, occurs-in from the story or section to an event whose verses overlap its ranges at all.
; The family relations (parent-of, sibling-of, partner-of) carry no verse: a client finds the verses of a relation from the
; occurrences of the two people in the parts, by the rule of ids.md ("Verses of a family relation").
topic-relations = {
  "types": strtab,
  "external": strtab,          ; ids of part A concepts, sorted by code point
  "from": uvarints,
  "to": uvarints,
  "type": uvarints,            ; a number in "types"
  "source": uvarints,          ; an index in "res"
  "confidence": uvarints,      ; 0 to 100
}

xtopics-part-tables = {
  "occurrences": verse-lists,  ; required, v1; the verses of this book behind the core's counts
}
