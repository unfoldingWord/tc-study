,"title":"Philippians","versification":"ufw"},{"categories":["bible-nt"],"exists":true,"identifier":"col","is_dir":false,"path":"./52-COL.usfm","size":121295,"sort":52,"title":"Colossians","versification":"ufw"},{"categories":["bible-nt"],"exists":true,"identifier":"1th","is_dir":false,"path":"./53-1TH.usfm","size":113584,"sort":53,"title":"1 Thessalonians","versification":"ufw"},{"categories":["bible-nt"],"exists":true,"identifier":"2th","is_dir":false,"path":"./54-2TH.usfm","size":62993,"sort":54,"title":"2 Thessalonians","versification":"ufw"},{"categories":["bible-nt"],"exists":true,"identifier":"1ti","is_dir":false,"path":"./55-1TI.usfm","size":126234,"sort":55,"title":"1 Timothy","versification":"ufw"},{"categories":["bible-nt"],"exists":true,"identifier":"2ti","is_dir":false,"path":"./56-2TI.usfm","size":96772,"sort":56,"title":"2 Timothy","versification":"ufw"},{"categories":["bible-nt"],"exists":true,"identifier":"tit","is_dir":false,"path":"./57-TIT.usfm","size":52551,"sort":57,"title":"Titus","versification":"ufw"},{"categories":["bible-nt"],"exists":true,"identifier":"phm","is_dir":false,"path":"./58-PHM.usfm","size":25925,"sort":58,"title":"Philemon","versification":"ufw"},{"categories":["bible-nt"],"exists":true,"identifier":"heb","is_dir":false,"path":"./59-HEB.usfm","size":385362,"sort":59,"title":"Hebrews","versification":"ufw"},{"categories":["bible-nt"],"exists":true,"identifier":"jas","is_dir":false,"path":"./60-JAS.usfm","size":134549,"sort":60,"title":"James","versification":"ufw"},{"categories":["bible-nt"],"exists":true,"identifier":"1pe","is_dir":false,"path":"./61-1PE.usfm","size":131239,"sort":61,"title":"1 Peter","versification":"ufw"},{"categories":["bible-nt"],"exists":true,"identifier":"2pe","is_dir":false,"path":"./62-2PE.usfm","size":86566,"sort":62,"title":"2 Peter","versification":"ufw"},{"categories":["bible-nt"],"exists":true,"identifier":"1jn","is_dir":false,"path":"./63-1JN.usfm","size":160029,"sort":63,"title":"1 John","versification":"ufw"},{"categories":["bible-nt"],"exists":true,"identifier":"2jn","is_dir":false,"path":"./64-2JN.usfm","size":18664,"sort":64,"title":"2 John","versification":"ufw"},{"categories":["bible-nt"],"exists":true,"identifier":"3jn","is_dir":false,"path":"./65-3JN.usfm","size":17126,"sort":65,"title":"3 John","versification":"ufw"},{"categories":["bible-nt"],"exists":true,"identifier":"jud","is_dir":false,"path":"./66-JUD.usfm","size":36191,"sort":66,"title":"Jude","versification":"ufw"},{"categories":["bible-nt"],"exists":true,"identifier":"rev","is_dir":false,"path":"./67-REV.usfm","size":741549,"sort":67,"title":"Revelation","versification":"ufw"}]},"contentStructure":"book","contentType":"text/usfm","description":"","format":"usfm","language":"el-x-koine","languageDirection":"ltr","languageName":"Koine Greek","languageTitle":"Koine Greek","license":{"id":"CC BY-SA 4.0"},"licenseFile":"","locations":[{"path":"git.door43.org/unfoldingWord/el-x-koine_ugnt","priority":1,"type":"network"}],"owner":"unfoldingWord","readme":"<img src=\"https://cdn.door43.org/assets/uw-icons/logo-ugnt-256.png\" alt=\"drawing\" width=\"100\"/>\n\n# unfoldingWord® Greek New Testament (UGNT)\n\n*An open-licensed, lexically tagged, morphologically parsed critical Greek New Testament with full apparatus. It enables the global Church to have access to the original texts of the New Testament.*\n\n## Basis\n\nThe UGNT text is based on the [Bunning Heuristic Prototype Greek New Testament (BHP)](https://git.door43.org/Door43/BHP). See the full rationale for the BHP text [here](https://git.door43.org/Door43/BHP/src/master/BHP.pdf). Also, see https://www.greekcntr.org for more information.\n\n## Changes from the BHP\n\nThe UGNT text differs from the BHP in only a few respects, which are:\n\n* Versification—The versification system used by the UGNT matches that of our [ULT](https://git.door43.org/unfoldingWord/en_ult). Currently, there is one difference:\n  * BHP *does not* have Acts 19:41 but UGNT does (see [this commit](https://git.door43.org/Door43/UGNT/commit/9bb309780ad21ca9d26e5155a716437f004c4577)).\n* Whole Verse Additions—The text of the UGNT is identical to the BHP except that we include several verses that the BHP omits. These are wrapped in single brackets [like this]. The full list of verses that we include are:\n  * Matthew 16:3; 17:21; 18:11; 23:14\n  * Mark 7:16; 9:44; 9:46; 11:26; 15:28; 16:9-20\n  * Luke 17:36; 22:43-44; 23:17\n  * John 5:4; 7:53; 8:1-11\n  * Acts 8:37; 15:34; 24:7; 28:29\n  * Romans 16:24\n* Partial Verse Additions—We are compiling a list of commonly used variants which we will include with existing verses. A list will be provided here when they are available.\n* Metadata—The UGNT text includes various metadata to mark the text which create links to other content that our software uses. For example, we add links to our [translationWords](https://git.door43.org/Door43/en_tw) articles where appropriate (about 33,737 occurrences).\n* We remove the English style quotation marks that the BHP has (see this [pull request](https://git.door43.org/unfoldingWord/UGNT/pulls/150)).\n\n## Related projects\n\n* [unfoldingWord® Greek Lexicon](https://git.door43.org/unfoldingWord/en_ugl)\n* [unfoldingWord® Literal Text](https://git.door43.org/unfoldingWord/en_ult)\n","release":{"html_url":"https://git.door43.org/unfoldingWord/el-x-koine_ugnt/releases/tag/v0.34","published_at":"2023-09-27T02:19:31Z","tag_name":"v0.34","tarball_url":"https://git.door43.org/unfoldingWord/el-x-koine_ugnt/archive/v0.34.tar.gz","zipball_url":"https://git.door43.org/unfoldingWord/el-x-koine_ugnt/archive/v0.34.zip"},"resourceId":"ugnt","resourceKey":"unfoldingWord/el-x-koine/ugnt","server":"git.door43.org","subject":"Greek New Testament","title":"unfoldingWord® Greek New Testament","type":"scripture","urls":{"metadata":"https://git.door43.org/unfoldingWord/el-x-koine_ugnt/raw/commit/fc95b2b8aad08bb65ab54628ab685413a1139e97/manifest.yaml"},"version":"v0.34"},"role":"original","stamp":"v0.34#2023-09-27T02_19_31Z","subject":"Greek New Testament","title":"unfoldingWord® Greek New Testament"}],"schema":2,"versions":{"align":{"helpsAlign":12},"prepared":{"scripturePrepare":6000230},"quote":{"helpsQuote":9},"sot":{"usjProcessing":"2.3.0-usj"},"text":{"helpsText":1}}}